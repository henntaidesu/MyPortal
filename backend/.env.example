# 复制成 .env 后按需要改。不建这个文件也能跑，用的就是这里的默认值。

# 认证中心监听地址。0.0.0.0 = 局域网其它机器也能访问
HOST=0.0.0.0
PORT=9921

# 门户会话有效期（小时）
SESSION_TTL_HOURS=12

# 一次性票据有效期（秒）。够浏览器跳一次就行，别调大
TICKET_TTL_SECONDS=60

# 整站走 https 时改成 true。http 下开了浏览器会直接丢掉登录 Cookie
COOKIE_SECURE=false

# 同一用户名在 LOGIN_FAIL_WINDOW 秒内失败 LOGIN_MAX_FAILS 次就先锁住
LOGIN_MAX_FAILS=5
LOGIN_FAIL_WINDOW=300

# 数据库和业务系统注册表的位置，一般不用改
# DB_PATH=D:\Project\Portal\backend\data\sso.db
# CLIENTS_PATH=D:\Project\Portal\backend\clients.json
# DIST_DIR=D:\Project\Portal\webside\dist
